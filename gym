print("===================================")
print("     GYM RECOMMENDATION SYSTEM     ")
print("===================================")

name = input("Enter your name: ")
age = int(input("Enter your age: "))
weight = float(input("Enter your weight (kg): "))
height = float(input("Enter your height (m): "))

bmi = weight / (height ** 2)

print("\nHello,", name)
print("Your BMI is:", round(bmi, 2))

if bmi < 18.5:
    bmi_status = "Underweight"
elif bmi < 25:
    bmi_status = "Normal Weight"
elif bmi < 30:
    bmi_status = "Overweight"
else:
    bmi_status = "Obese"

print("BMI Category:", bmi_status)

print("\nFitness Goals:")
print("1. Weight Loss")
print("2. Muscle Gain")
print("3. General Fitness")

choice = int(input("Choose your goal (1-3): "))

print("\n========== RECOMMENDATION ==========")

if choice == 1:
    print("Goal: Weight Loss")
    print("\nWorkout Plan:")
    print("- Running: 30 minutes")
    print("- Cycling: 20 minutes")
    print("- Jump Rope: 15 minutes")
    print("- HIIT Training: 20 minutes")
    
    print("\nDiet Tips:")
    print("- Eat more vegetables")
    print("- Avoid sugary drinks")
    print("- Drink 3 liters of water")
    print("- Increase protein intake")

elif choice == 2:
    print("Goal: Muscle Gain")
    print("\nWorkout Plan:")
    print("- Bench Press")
    print("- Squats")
    print("- Deadlifts")
    print("- Pull-Ups")
    print("- Shoulder Press")
    
    print("\nDiet Tips:")
    print("- Eat high-protein foods")
    print("- Consume healthy carbohydrates")
    print("- Eat every 3-4 hours")
    print("- Drink enough water")

elif choice == 3:
    print("Goal: General Fitness")
    print("\nWorkout Plan:")
    print("- Push-Ups")
    print("- Plank")
    print("- Jogging")
    print("- Bodyweight Squats")
